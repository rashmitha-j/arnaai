# Copy to .env and fill in.  cp .env.example .env

# ---- LLM (LangChain + Gemini)
# gemini  = Google AI Studio API key (easiest: https://aistudio.google.com/apikey)
# vertex  = Vertex AI with your GCP credentials (used on Cloud Run)
# offline = no LLM, template replies (for demos/tests without a key)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cheaper model for slot extraction + LLM safety review. Quotas are per model, so this
# spreads the free-tier load. Leave empty to use GEMINI_MODEL for both.
EXTRACTION_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.6
# Per-call deadline and retries; a slow/failed call falls back to templates instead of stalling the chat
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# ---- Security
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Shared access code for the counselor dashboard (/counselor). Use a long random value.
COUNSELOR_TOKEN=change-me-to-a-long-random-string
# Shared secret between the therapy and emotion services
SERVICE_KEY=local-service-key

# ---- Storage: sqlite (local) or firestore (GCP)
STORAGE_BACKEND=sqlite
SQLITE_PATH=arnaai.db

# ---- Services
EMOTION_SERVICE_URL=http://127.0.0.1:8081
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30

# ---- Human-in-the-loop alerts (optional): Google Chat or Slack incoming webhook.
# Alerts contain only ids and risk level, never conversation text.
ESCALATION_WEBHOOK_URL=
PUBLIC_APP_URL=http://localhost:3000

# ---- Crisis resources shown to users (optional JSON override)
# CRISIS_RESOURCES_JSON=[{"name":"Tele-MANAS (India, 24x7, free)","contact":"14416"}]
